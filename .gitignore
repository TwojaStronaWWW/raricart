# Collective .gitignore for Raricart repository

# Dependencies
vendor/
node_modules/

# Logs & Backups
*.log
*.bak
*.bak.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Environment / Secrets / Keys (ISO 27001)
.env
.env.*
!.env.example
*.pem
*.key
*.kdbx
id_ed25519*
config/secrets.php
assets/data/config.json
assets/data/content.json
assets/data/login_attempts.json
assets/data/reset_tokens.json

# Generated audits & local npm config
docs/audits/

# Exclude existing git history from subfolders if they were not removed
**/.git/

# PHP specific
composer.phar
.phpunit.result.cache

# deploys / runtime
.ftp-deploy-sync-state.json
.htpasswd

# Runtime data
admin/leady.csv
drafts/
api/drafts/
api/rate_limits/
assets/uploads/

# IDE
.vscode/
.idea/

# Runtime config
assets/data/*.json
!assets/data/*.json.dist
!assets/data/ai-config.json

# Uploads
assets/gallery/
assets/images/parallax/
assets/images/gallery/
assets/images/img_*
assets/img/migration_source/
assets/video/
*.mp4
*.MP4
uploads/

# Legacy subfolder
site/
testpkg/
