#!/usr/bin/env bash
# Git Pre-commit Hook dla repozytorium Raricart.pl
# Wzorowany na standardach jakościowych projektów Gal Anonim i _site-template.
# Uruchamia sprawdzenie składni JS/PHP oraz wszystkie testy jednostkowe przed zatwierdzeniem zmian.

set -e

echo "🔍 [pre-commit] Uruchamianie lokalnej bramy jakościowej (Quality Gate)..."

npm run check

echo "✅ [pre-commit] Wszystkie testy przeszły pomyślnie! Zezwolono na commit."
