# Ochrona katalogu API (OWASP ASVS / [REF-05])
Options -Indexes

# Blokada bezpośredniego dostępu do bibliotek wewnętrznych PHP
<FilesMatch "^(core|leads-store|rate-limit|MediaService|PrivateStorageService|R2Client)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Blokada plików danych, kopii zapasowych, sekretów i blokad
<FilesMatch "(\.(json|bak|csv|sqlite|db|dist|log|md|pem|key|kdbx|lock|txt|sh|yml|yaml)$|^\.env)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
