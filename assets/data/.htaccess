# Protect sensitive JSON files from direct access
<Files "config.json">
    Order Deny,Allow
    Deny from all
</Files>

<Files "reset_tokens.json">
    Order Deny,Allow
    Deny from all
</Files>

<Files "login_attempts.json">
    Order Deny,Allow
    Deny from all
</Files>

# Allow public access to content and status for JS
<FilesMatch "^(content|status|gallery)\.json$">
    Order Allow,Deny
    Allow from all
</FilesMatch>
